# Copy this file to .env (or set in Vercel project env) and fill in values.
# All Vite client envs MUST be prefixed VITE_; their values ship in the bundle.

# Admin gate. Note: this is a client-side check baked into the JS — anyone
# can read it via view-source. Replace with a real auth flow before relying
# on /admin for anything sensitive.
VITE_ADMIN_PASSWORD=change-me

# Sentry — leave empty to disable in dev. Get the DSN from your Sentry project
# settings (Settings → Projects → [project] → Client Keys).
VITE_SENTRY_DSN=

# Optional release tag used by Sentry to group errors per deploy.
VITE_APP_VERSION=

# Plausible — your verified site domain. Leave empty to disable analytics.
VITE_PLAUSIBLE_DOMAIN=
